<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- QUERY_ALL_PACKAGES: Navigate must find ALL launchable apps — that is
         the core function of a launcher, not a side effect.

         Why it does not work without it (measured on the target device):
         - LauncherApps.getActivityList() only knows CATEGORY_LAUNCHER and
           thereby hides every leanback-only app: Prime Video
           (com.amazon.amazonvideo.livingroom), WOW (com.wbd.stream) and
           ARD (de.swr.avp.ard.tv) carry ONLY CATEGORY_LEANBACK_LAUNCHER.
         - The package visibility rules since Android 11 have NO exception for
           the home app (developer.android.com/training/package-visibility/automatic
           lists them exhaustively) — a LEANBACK query via the
           PackageManager would therefore be incomplete.
         Launching would be possible even without the permission; FINDING not. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Optional, and explicitly only for this: “HOME or BACK on the home
         screen → back into the last app”. With the app op the answer is exact
         (`UsageStatsManager.queryEvents`); without it the marker of the
         app last launched via Navigate applies.
         It is NOT requested at runtime (a launcher cannot do that),
         but via
         `adb shell appops set com.piotv.navigate GET_USAGE_STATS allow`
         (see docs/INSTALL.md). If it is missing, Navigate still starts. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Context menu (long OK on an app):
         - REQUEST_DELETE_PACKAGES shows the system dialog for uninstalling
           (a launcher may not uninstall on its own),
         - KILL_BACKGROUND_PROCESSES allows closing apps that sit in the
           background. Both are normal permissions without a dialog. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- No touchscreen needed (remote control); TV is the target platform but
         not mandatory: this way Navigate also runs on a tablet/phone for testing. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Navigate">

        <!-- One single activity, one state: the home screen with all apps in
             the grid. Up to 0.5 there was additionally a second state (only the
             bottom row above the running app) — with two HOME activities the
             system's resolution would be ambiguous (chooser instead of direct
             start), so it was one activity with two window sizes; since 0.6 it
             is one activity with one content.

             launchMode=singleTask: every HOME press arrives as onNewIntent,
             a second instance is never built.
             excludeFromRecents: a launcher does not belong in "Recents".
             stateNotNeeded: the system may restart the activity at any time.
             configChanges: TV devices report uiMode/density changes; without
             this list the activity would be recreated (= visible flicker).

             screenOrientation=landscape with tools:ignore="DiscouragedApi":
             from Android 16 on, systems ignore the fixed orientation anyway
             (lint: DiscouragedApi). On the target device this has no effect — a
             TV knows only one orientation.
             android:label is deliberately absent here: it would be identical to
             the app label (lint: RedundantLabel). -->
        <activity
            android:name=".LauncherActivity"
            android:alwaysRetainTaskState="true"
            android:banner="@drawable/banner"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Navigate"
            tools:ignore="DiscouragedApi">

            <!-- HOME: this makes Navigate a launcher app.
                 LEANBACK_LAUNCHER: so it additionally shows up in the TV apps
                 list (e.g. to get back in after being deactivated, without
                 resorting to the settings).

                 priority=10 is not decorative: on the Chromecast (Google TV),
                 com.google.android.tungsten.setupwraith/.RecoveryActivity
                 carries a HOME filter with priority=1 and thereby wins the
                 resolution of the HOME intent, even though Navigate holds the
                 HOME role (measured on 2026-10-14 on the target device). A
                 higher value is the only way to solve that without disabling a
                 system app. -->
            <intent-filter android:priority="10">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The settings. No HOME activity, no intent filter: it is started
             only from the home screen (long OK on “…”) and is thus not a
             second ambiguity in HOME resolution.
             exported=false because nobody else needs to be able to start it. -->
        <activity
            android:name=".ui.SettingsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.Navigate" />

        <!-- The access key to the “Now Playing” field (see NowPlayingListener):
             `MediaSessionManager.getActiveSessions` requires a registered
             notification listener. The service reads **no**
             notifications — the registered component name is the
             credential. Grant (once, docs/INSTALL.md step 5b):
               adb shell cmd notification allow_listener com.piotv.navigate/.NowPlayingListener

             exported=true is mandatory (the system binds the service), and
             BIND_NOTIFICATION_LISTENER_SERVICE keeps everyone else out. -->
        <service
            android:name=".NowPlayingListener"
            android:exported="true"
            android:label="@string/now_playing_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>

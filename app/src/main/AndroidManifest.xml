<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- QUERY_ALL_PACKAGES: Navigate muss ALLE startbaren Apps finden — das ist
         die Kernfunktion eines Launchers, nicht ein Nebeneffekt.

         Warum es ohne nicht geht (auf dem Zielgerät gemessen):
         - LauncherApps.getActivityList() kennt nur CATEGORY_LAUNCHER und
           verschweigt damit jede leanback-only App: Prime Video
           (com.amazon.amazonvideo.livingroom), WOW (com.wbd.stream) und
           ARD (de.swr.avp.ard.tv) tragen NUR CATEGORY_LEANBACK_LAUNCHER.
         - Die Package-Visibility-Regeln ab Android 11 haben KEINE Ausnahme für
           die Home-App (developer.android.com/training/package-visibility/automatic
           listet sie erschöpfend) — eine LEANBACK-Abfrage über den
           PackageManager wäre also unvollständig.
         Starten wäre auch ohne die Berechtigung möglich, FINDEN nicht. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Optional, und ausdrücklich nur dafür: „HOME oder BACK auf der Home-Seite
         → zurück in die letzte App“. Mit dem App-Op ist die Antwort exakt
         (`UsageStatsManager.queryEvents`), ohne ihn greift der Merker der
         zuletzt über Navigate gestarteten App.
         Er wird NICHT zur Laufzeit erfragt (das kann ein Launcher nicht),
         sondern per
         `adb shell appops set com.piotv.navigate GET_USAGE_STATS allow`
         (siehe docs/INSTALL.md). Fehlt er, startet Navigate trotzdem. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Kontextmenü (langes OK auf einer App):
         - REQUEST_DELETE_PACKAGES zeigt den System-Dialog zum Deinstallieren
           (ein Launcher darf nicht selbst deinstallieren),
         - KILL_BACKGROUND_PROCESSES erlaubt das Schließen von Apps, die im
           Hintergrund stehen. Beides sind normale Berechtigungen ohne Dialog. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Kein Touchscreen nötig (Fernbedienung), TV ist Zielplattform, aber nicht
         Pflicht: so läuft Navigate auch auf einem Tablet/Handy zum Testen. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Navigate">

        <!-- Eine einzige Activity, ein Zustand: die Home-Seite mit allen Apps im
             Raster. Bis 0.5 gab es zusätzlich einen zweiten Zustand (nur die
             untere Zeile über der laufenden App) — mit zwei HOME-Activities wäre
             die Auflösung des Systems mehrdeutig (Chooser statt Direktstart),
             deshalb war es eine Activity mit zwei Fenstergrößen; seit 0.6 ist es
             eine Activity mit einem Inhalt.

             launchMode=singleTask: jeder HOME-Druck kommt als onNewIntent an,
             es wird nie eine zweite Instanz gebaut.
             excludeFromRecents: der Launcher gehört nicht in "Zuletzt benutzt".
             stateNotNeeded: das System darf die Activity jederzeit neu starten.
             configChanges: TV-Geräte melden uiMode/density-Änderungen; ohne
             diese Liste würde die Activity neu erzeugt (= sichtbares Flackern).

             screenOrientation=landscape mit tools:ignore="DiscouragedApi":
             ab Android 16 ignorieren Systeme die feste Ausrichtung ohnehin
             (lint: DiscouragedApi). Auf dem Zielgerät ist das folgenlos — ein
             Fernseher kennt nur eine Ausrichtung.
             android:label fehlt hier absichtlich: sie wäre identisch mit der
             App-Beschriftung (lint: RedundantLabel). -->
        <activity
            android:name=".LauncherActivity"
            android:alwaysRetainTaskState="true"
            android:banner="@drawable/banner"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Navigate"
            tools:ignore="DiscouragedApi">

            <!-- HOME: damit ist Navigate eine Launcher-App.
                 LEANBACK_LAUNCHER: damit sie zusätzlich in der TV-Apps-Liste
                 auftaucht (z. B. um nach dem Deaktivieren wieder hinein zu
                 kommen, ohne die Einstellungen zu bemühen).

                 priority=10 ist kein Zierwert: auf dem Chromecast (Google TV)
                 trägt com.google.android.tungsten.setupwraith/.RecoveryActivity
                 einen HOME-Filter mit priority=1 und gewinnt damit die
                 Auflösung des HOME-Intents, obwohl Navigate die HOME-Rolle
                 hält (gemessen am 2026-10-14 auf dem Zielgerät). Ein höherer
                 Wert ist der einzige Weg, das ohne Deaktivieren einer
                 System-App zu lösen. -->
            <intent-filter android:priority="10">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Die Einstellungen. Keine HOME-Activity, kein Intent-Filter: sie wird
             ausschließlich aus der Home-Seite gestartet (langes OK auf „…“) und
             ist damit keine zweite Mehrdeutigkeit bei der HOME-Auflösung.
             exported=false, weil niemand sonst sie starten können muss. -->
        <activity
            android:name=".ui.SettingsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.Navigate" />

        <!-- Der Zugangsschlüssel zum „Now Playing“-Feld (siehe NowPlayingListener):
             `MediaSessionManager.getActiveSessions` verlangt einen eingetragenen
             Benachrichtigungs-Listener. Der Dienst liest **keine**
             Benachrichtigungen — der eingetragene Komponentenname ist der
             Ausweis. Freigabe (einmalig, docs/INSTALL.md Schritt 5b):
               adb shell cmd notification allow_listener com.piotv.navigate/.NowPlayingListener

             exported=true ist Pflicht (das System bindet den Dienst), und
             BIND_NOTIFICATION_LISTENER_SERVICE lässt sonst niemanden hinein. -->
        <service
            android:name=".NowPlayingListener"
            android:exported="true"
            android:label="@string/now_playing_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>

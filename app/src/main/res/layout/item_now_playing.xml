<?xml version="1.0" encoding="utf-8"?>
<!-- A “Now Playing” row: cover, app name and what is playing.

     It is inflated once for **every** app with an active media session
     (NowPlayingPanel) and then reused — the same idea as
     `convertView` in the grid. That is why it is its own file and not a
     child of activity_home.xml.

     Focusable like a grid cell: OK on the row brings the playing app
     back (the “now playing” screen, otherwise the app itself). The
     focus marker is the same as the earlier single block's
     (bg_now_playing, state_focused). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/now_playing_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_now_playing"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/now_playing_padding">

    <ImageView
        android:id="@+id/now_playing_row_art"
        android:layout_width="@dimen/now_playing_art_size"
        android:layout_height="@dimen/now_playing_art_size"
        android:layout_marginEnd="@dimen/now_playing_art_margin_end"
        android:contentDescription="@string/cd_now_playing_art"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/now_playing_row_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/text_dim"
        android:textSize="@dimen/now_playing_text_size" />
</LinearLayout>

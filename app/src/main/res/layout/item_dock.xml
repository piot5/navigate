<?xml version="1.0" encoding="utf-8"?>
<!-- Ein Dock-Element: Favoriten-App ODER Aktion (Home/Einstellungen).
     Diese Views sind echt fokussierbar (im Gegensatz zu den Raster-Zellen),
     deshalb hängt die Markierung an state_focused und wird über
     duplicateParentState an Icon und Label vererbt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/dock_item_width"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dock_item"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/dock_icon"
        android:layout_width="@dimen/dock_icon"
        android:layout_height="@dimen/dock_icon"
        android:duplicateParentState="true" />

    <TextView
        android:id="@+id/dock_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/dock_label"
        android:textSize="@dimen/dock_label_text_size" />
</LinearLayout>

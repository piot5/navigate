<?xml version="1.0" encoding="utf-8"?>
<!-- The Navigate settings: a list of toggles.

     No background of its own on the root layout: the theme
     (Theme.Navigate → android:windowBackground) already paints it; a second time
     would be overdraw (lint: Overdraw). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/settings_padding_h"
    android:paddingTop="@dimen/settings_padding_top"
    android:paddingEnd="@dimen/settings_padding_h"
    android:paddingBottom="@dimen/settings_padding_h">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/settings_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/settings_title_text_size" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_hint_margin_top"
        android:includeFontPadding="false"
        android:text="@string/settings_hint"
        android:textColor="@color/text_dim"
        android:textSize="@dimen/settings_hint_text_size" />

    <ListView
        android:id="@+id/settings_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/settings_list_margin_top"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:focusable="true"
        android:listSelector="@drawable/bg_item_selected"
        android:scrollbars="none" />

    <!-- Only visible when the setting is on and access is missing.
         Color `text_dim` like every hint on this page: the row was green until
         0.13 (`text_active`) — since 0.14 there is no green text anymore. -->
    <TextView
        android:id="@+id/settings_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/settings_no_access"
        android:textColor="@color/text_dim"
        android:textSize="@dimen/settings_hint_text_size"
        android:visibility="gone" />

    <TextView
        android:id="@+id/settings_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_hint_margin_top"
        android:ellipsize="middle"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/text_dim"
        android:textSize="@dimen/settings_path_text_size" />

    <!-- The route for `adb push`: ADB cannot write the internal file without
         root; the external path is picked up on the next access. -->
    <TextView
        android:id="@+id/settings_import_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/text_dim"
        android:textSize="@dimen/settings_path_text_size" />

    <!-- The path of the background file (0.14) — visible only when an image
         is chosen, and then with the honest answer of whether the file
         exists. Only `adb push` can fill it. -->
    <TextView
        android:id="@+id/settings_background_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:textColor="@color/text_dim"
        android:textSize="@dimen/settings_path_text_size"
        android:visibility="gone" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Die Navigate-Einstellungen: eine Liste mit Schaltern.

     Kein eigener Hintergrund am Wurzel-Layout: das Theme
     (Theme.Navigate → android:windowBackground) malt ihn schon, ein zweites Mal
     wäre Overdraw (lint: Overdraw). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/settings_padding_h"
    android:paddingTop="@dimen/settings_padding_top"
    android:paddingEnd="@dimen/settings_padding_h"
    android:paddingBottom="@dimen/settings_padding_h">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/settings_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/settings_title_text_size" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_hint_margin_top"
        android:includeFontPadding="false"
        android:text="@string/settings_hint"
        android:textColor="@color/text_dim"
        android:textSize="@dimen/settings_hint_text_size" />

    <ListView
        android:id="@+id/settings_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/settings_list_margin_top"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:focusable="true"
        android:listSelector="@drawable/bg_item_selected"
        android:scrollbars="none" />

    <!-- Nur sichtbar, wenn die Einstellung an ist und der Zugriff fehlt. -->
    <TextView
        android:id="@+id/settings_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/settings_no_access"
        android:textColor="@color/text_active"
        android:textSize="@dimen/settings_hint_text_size"
        android:visibility="gone" />

    <TextView
        android:id="@+id/settings_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_hint_margin_top"
        android:ellipsize="middle"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/text_dim"
        android:textSize="@dimen/settings_path_text_size" />

    <!-- Der Weg für `adb push`: die interne Datei kann ADB ohne Root nicht
         schreiben, der externe Pfad wird beim nächsten Zugriff übernommen. -->
    <TextView
        android:id="@+id/settings_import_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/text_dim"
        android:textSize="@dimen/settings_path_text_size" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen: the app grid, the “…” button and the top row.

     Collapsed (default): at the bottom there is **one** row of apps; below it,
     in the row beneath, the “…” button. The rest of the screen stays empty.
     Expanded: the grid fills the screen and scrolls; the “…” button
     stays at the very bottom.

     So both states work without a second layout, the column
     (`@id/column`) hangs at the **bottom** edge: collapsed, the grid is only
     one row tall (the adapter then reports only one row); expanded, it gets
     all the space above via `layout_weight`.

     The root node is deliberately `<merge>`: both children land directly in
     the activity's content container. The background lives in the theme
     (`Theme.Navigate → android:windowBackground`) — painting it here too
     would be overdraw. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- The background (0.14) — two options, see data/Background.kt.
         The view sits **behind** the grid: children of a `<merge>` land in
         their order in the content container, so the first child is the
         bottom layer. It is `gone` by default — the theme's solid
         background (@color/bg_home) remains the default.

         The image is decoded downscaled to screen size
         (LauncherActivity): a 4K photo would be 33 MB in memory for a surface
         that a TV cannot resolve from three meters away. -->
    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cd_background"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- The dimming layer over the background: without it a bright photo
         competes with the app labels. It sits above the image and below the
         grid — and is only visible when there is a background. -->
    <View
        android:id="@+id/background_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_scrim"
        android:visibility="gone" />


    <LinearLayout
        android:id="@+id/column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical">

        <!-- GridView (framework) instead of RecyclerView: D-pad navigation,
             scrolling and view recycling are built in and cost no extra
             dependency.

             listSelector explicitly transparent instead of "@null": the theme
             ships its own selection background (on the target device an
             orange box), and "@null" does not switch it off. The marker is
             drawn solely by @drawable/bg_grid_item (rounded blue
             border). -->
        <com.piotv.navigate.ui.HomeGridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:listSelector="@android:color/transparent"
            android:paddingStart="@dimen/grid_padding_h"
            android:paddingTop="@dimen/grid_padding_top"
            android:paddingEnd="@dimen/grid_padding_h"
            android:paddingBottom="@dimen/grid_padding_bottom"
            android:horizontalSpacing="@dimen/grid_h_spacing"
            android:verticalSpacing="@dimen/grid_v_spacing"
            android:stretchMode="columnWidth"
            android:scrollbars="none"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- The row below the app row: the “…” button, right-aligned under the
             last cell. The insets match those of the grid so it sits
             exactly beneath it. -->
        <LinearLayout
            android:id="@+id/more_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/grid_padding_h"
            android:paddingEnd="@dimen/grid_padding_h"
            android:paddingBottom="@dimen/more_row_padding_bottom">

            <TextView
                android:id="@+id/more"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/more_button_height"
                android:background="@drawable/bg_more_item"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="@dimen/more_min_width"
                android:paddingStart="@dimen/more_padding_h"
                android:paddingEnd="@dimen/more_padding_h"
                android:text="@string/more_glyph"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/more_glyph_text_size" />
        </LinearLayout>
    </LinearLayout>

    <!-- The top row: “Now Playing” on the left (only when switched on **and**
         the grid is collapsed), the clock on the right. Both in one row so a
         long title cannot overtake the clock: the text gets, via
         `layout_weight`, exactly the space that is left and cuts off with
         an ellipsis.

         The container has been **empty** since 0.13: NowPlayingPanel builds the
         rows, one per app with an active media session plus the history below
         (item_now_playing.xml). A block of its own it was until 0.12 — back then
         there was exactly one row, and it could live in the layout.

         The history grows dynamically: the ScrollView (`PanelScrollView`) takes
         at most `now_playing_max_height`, after that the block scrolls — the
         grid does not slide down endlessly. **That only holds since 0.15.1:**
         until then the value sat on the ScrollView as `android:maxHeight`, and
         that attribute does not exist there — the view grew with the history
         until the grid was out of the picture. The value now comes as
         `app:maxHeight` from our own namespace (`res/values/attrs.xml`), and
         the scrollbar is always visible so it is apparent that there is more.

         The clock is updated once a minute (a per-second tick would be a timer
         per second — measurable on the Chromecast, without benefit). -->
    <LinearLayout
        android:id="@+id/top_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingStart="@dimen/clock_margin"
        android:paddingTop="@dimen/top_row_padding_top"
        android:paddingEnd="@dimen/clock_margin">

        <!-- PanelScrollView instead of ScrollView: the height limit (app:maxHeight),
             which the framework does not know on ScrollView, and the row-by-row
             arrow-key handling live in ui/PanelScrollView.kt.

             focusable="false": the area itself must not take focus, but
             a row. Otherwise ▲ from the grid would land on a focus with no
             marker.

             The scrollbar is always visible (fadeScrollbars="false") and sits
             inside (scrollbarStyle="insideInset") so it does not cover the row
             text. -->
        <com.piotv.navigate.ui.PanelScrollView
            android:id="@+id/now_playing_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/now_playing_end_margin"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:focusable="false"
            android:scrollbarSize="@dimen/now_playing_scrollbar_size"
            android:scrollbarStyle="insideInset"
            android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
            android:scrollbars="vertical"
            android:visibility="gone"
            app:maxHeight="@dimen/now_playing_max_height">

            <LinearLayout
                android:id="@+id/now_playing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.piotv.navigate.ui.PanelScrollView>

        <!-- layout_gravity="top" (0.17): the clock stays at the top edge of the
             row even when the Now Playing block next to it grows taller — before
             it centered itself next to it. -->
        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_gravity="top"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/clock_text_size" />
    </LinearLayout>

</merge>

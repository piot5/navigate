<?xml version="1.0" encoding="utf-8"?>
<!-- Eine Zeile in den Navigate-Einstellungen: links der Name, rechts der Stand
     („An“/„Aus“).

     Der Fokus kommt von der ListView (`listSelector`), deshalb braucht diese
     Zeile keinen eigenen Zustands-Selector: eine ListView zeichnet ihren
     listSelector nur, solange sie selbst den Fokus hat — genau das gewünschte
     Verhalten. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/settings_row_height"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/grid_cell_padding"
    android:paddingEnd="@dimen/grid_cell_padding">

    <TextView
        android:id="@+id/setting_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/settings_label_text_size" />

    <TextView
        android:id="@+id/setting_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:includeFontPadding="false"
        android:minWidth="@dimen/settings_marker_min_width"
        android:textColor="@color/item_focus_stroke"
        android:textSize="@dimen/settings_label_text_size" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Der komplette Launcher: eine Activity, ein Layout, zwei Sichtbarkeits-Zustände.

     GRID-Modus (keine App läuft): root malt @color/bg_home deckend über das
     ganze Fenster → sieht wie eine normale Home-Seite aus, obwohl das Fenster
     technisch translucide ist.
     DOCK-Modus (App läuft): root bleibt transparent, nur @id/dock ist sichtbar
     und das Fenster wird per WindowManager auf Höhe des Docks geschrumpft —
     die laufende App bleibt dahinter sichtbar.

     Wichtig: keine Animationen, keine Verschachtelung, keine Fragments.
     Was hier steht, wird bei jedem HOME-Druck neu gemessen und gezeichnet. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Alle Apps als Raster. GridView (Framework) statt RecyclerView:
         D-Pad-Navigation, Scrollen und View-Recycling sind eingebaut und
         kosten keine zusätzliche Abhängigkeit. -->
    <com.piotv.navigate.ui.AppGridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/grid_margin_bottom"
        android:clipToPadding="false"
        android:paddingStart="@dimen/grid_padding_h"
        android:paddingTop="@dimen/grid_padding_top"
        android:paddingEnd="@dimen/grid_padding_h"
        android:paddingBottom="@dimen/grid_padding_bottom"
        android:horizontalSpacing="@dimen/grid_h_spacing"
        android:verticalSpacing="@dimen/grid_v_spacing"
        android:stretchMode="columnWidth"
        android:listSelector="@null"
        android:scrollbars="none"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone" />

    <!-- Uhr nur im GRID-Modus, und dort nur einmal pro Minute aktualisiert
         (kein Sekundentakt: ein Timer pro Sekunde ist auf dem Chromecast
         messbar und bringt nichts). -->
    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/clock_margin"
        android:includeFontPadding="false"
        android:textColor="@color/text_dim"
        android:textSize="@dimen/clock_text_size"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dock_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/dock_margin_h"
        android:layout_marginEnd="@dimen/dock_margin_h"
        android:layout_marginBottom="@dimen/dock_margin_bottom"
        android:background="@drawable/bg_dock"
        android:visibility="gone">

        <!-- Inhalt wird zur Laufzeit gefüllt: Favoriten (dynamisch) + Home +
             Einstellungen. Ein Layout pro Dock-Element (item_dock.xml), damit
             Favorit und Aktion identisch aussehen und sich identisch verhalten. -->
        <LinearLayout
            android:id="@+id/dock_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal" />
    </FrameLayout>

</FrameLayout>

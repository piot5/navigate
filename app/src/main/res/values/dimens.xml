<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="grid_padding_h">28dp</dimen>
    <!-- top: room for the top row (“Now Playing” and clock) -->
    <dimen name="grid_padding_top">52dp</dimen>
    <dimen name="grid_padding_bottom">24dp</dimen>
    <dimen name="grid_h_spacing">4dp</dimen>
    <dimen name="grid_v_spacing">4dp</dimen>
    <dimen name="grid_icon">64dp</dimen>
    <dimen name="grid_cell_padding">8dp</dimen>
    <dimen name="grid_label_text_size">14sp</dimen>

    <!-- The “…” glyph sits in a box of icon size. -->
    <dimen name="more_glyph_text_size">28sp</dimen>
    <dimen name="more_button_height">48dp</dimen>
    <dimen name="more_min_width">96dp</dimen>
    <dimen name="more_padding_h">16dp</dimen>
    <dimen name="more_row_padding_bottom">12dp</dimen>

    <dimen name="clock_text_size">30sp</dimen>
    <dimen name="clock_margin">28dp</dimen>

    <!-- The top row: “Now Playing” on the left, the clock on the right. The gap
         between them is the reserve in case a long title reaches the clock —
         the text does its own ellipsizing (maxLines/ellipsize). -->
    <dimen name="top_row_padding_top">16dp</dimen>
    <dimen name="now_playing_text_size">20sp</dimen>
    <dimen name="now_playing_end_margin">24dp</dimen>
    <!-- The cover: as tall as two text lines, no taller — the row remains
         the main thing. The size also lives in code (NowPlaying scales the
         session's image down to it), which is why it is its own resource. -->
    <dimen name="now_playing_art_size">40dp</dimen>
    <dimen name="now_playing_art_margin_end">12dp</dimen>
    <dimen name="now_playing_padding">6dp</dimen>
    <!-- Spacing between two Now Playing rows. Since 0.13 there is one row per
         app with an active media session — without spacing two rows would
         stick together, and the focus marker (bg_now_playing) would not read
         as the marker of one row. -->
    <dimen name="now_playing_row_spacing">4dp</dimen>
    <!-- Between the Now Playing block and the first grid row. The grid starts
         as deep as the block is tall (LauncherActivity), plus this spacing. -->
    <dimen name="now_playing_gap_bottom">8dp</dimen>
    <!-- The Now Playing block (live + history) is at most this tall: beyond
         that it scrolls inside its ScrollView instead of pushing the grid
         endlessly down. ~5 rows at 52 dp on 1080p — collapsed, the grid
         below stays usable.

         **Effective since 0.15.1.** Until then the value sat on the ScrollView as
         `android:maxHeight` — an attribute that does not exist there (the platform
         only knows it for ImageView, ExpandableListView and MaxHeightFrameLayout).
         aapt2 let it through because the attribute exists; the ScrollView did not
         care. Now PanelScrollView reads the value as `app:maxHeight`. -->
    <dimen name="now_playing_max_height">260dp</dimen>
    <!-- The scrollbar thumb in the block: wide enough to read as a position
         from three meters away, rounded like the other surfaces. -->
    <dimen name="now_playing_scrollbar_size">6dp</dimen>
    <dimen name="now_playing_scrollbar_radius">3dp</dimen>

    <!-- The Navigate settings -->
    <dimen name="settings_padding_h">48dp</dimen>
    <dimen name="settings_padding_top">28dp</dimen>
    <dimen name="settings_title_text_size">26sp</dimen>
    <dimen name="settings_hint_text_size">14sp</dimen>
    <dimen name="settings_hint_margin_top">4dp</dimen>
    <dimen name="settings_list_margin_top">12dp</dimen>
    <!-- Tall enough for the remote: a 56 dp target can be hit from three
         meters; 48 dp is the lower bound Android names for touch. -->
    <dimen name="settings_row_height">56dp</dimen>
    <dimen name="settings_label_text_size">20sp</dimen>
    <dimen name="settings_marker_min_width">72dp</dimen>
    <dimen name="settings_path_text_size">12sp</dimen>
</resources>

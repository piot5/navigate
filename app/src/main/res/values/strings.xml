<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Navigate</string>

    <!-- Der „…“-Knopf am Ende der ersten Zeile. Die Glyphe steht hier und nicht
         im Layout: ein hartcodierter Text wäre eine lint-Warnung, und Warnungen
         sind in diesem Projekt Fehler. -->
    <string name="more_glyph">•••</string>
    <string name="more_label">Mehr anzeigen</string>
    <string name="less_label">Weniger anzeigen</string>

    <!-- Kontextmenü (langes OK auf einer App) -->
    <string name="menu_move_forward">Position nach vorne</string>
    <string name="menu_move_backward">Position nach hinten</string>
    <string name="menu_uninstall">App deinstallieren</string>
    <string name="menu_close">App schließen</string>
    <string name="menu_close_all">Alle Apps schließen</string>

    <!-- Rückmeldungen. Kurz gehalten: ein Toast ist auf TV 1,5 s sichtbar,
         lange Sätze liest dort niemand zu Ende. -->
    <string name="toast_launch_failed">App lässt sich nicht starten</string>
    <string name="toast_order_moved">Eine Position nach vorne</string>
    <string name="toast_order_first">Steht schon ganz vorne</string>
    <string name="toast_order_back">Eine Position nach hinten</string>
    <string name="toast_order_last">Steht schon ganz hinten</string>
    <string name="toast_uninstall_failed">Deinstallieren nicht möglich</string>
    <string name="toast_closed_all">Hintergrund-Apps geschlossen</string>

    <!-- Die Navigate-Einstellungen — erreichbar über langes OK auf „…“. -->
    <string name="settings_title">Einstellungen</string>
    <string name="settings_hint">OK schaltet um · ▲ ▼ wählt · ◀ oder BACK zurück</string>
    <string name="settings_now_playing">Now Playing anzeigen</string>
    <string name="settings_on">An</string>
    <string name="settings_off">Aus</string>
    <!-- Ehrlich statt still: eine Einstellung, die eingeschaltet ist und dann
         nichts tut, wäre die unangenehmste Sorte Einstellung. -->
    <string name="settings_no_access">Kein Benachrichtigungszugriff — das Feld bleibt leer</string>
    <string name="settings_path_label">Datei: %1$s</string>
    <string name="settings_import_path_label">Import (adb push): %1$s</string>

    <!-- Der Dienst, der den Blick in die Media-Sessions erlaubt. Sein Text steht
         in Androids Liste der Benachrichtigungszugriffe — deshalb ein eigener
         Text und nicht der App-Name. -->
    <string name="now_playing_listener_label">Navigate — Now Playing</string>

    <!-- Rückfall-Beschreibung des Cover-Bildes im „Now Playing“-Block. Sie wird
         zur Laufzeit durch die Zeile ersetzt (LauncherActivity). -->
    <string name="cd_now_playing_art">Cover</string>

    <!-- Rückfall-Beschreibung für die Symbol-ImageView im Raster. Sie wird zur
         Laufzeit durch den App-Namen ersetzt (AppAdapter) — der XML-Wert gilt
         nur, solange eine recycelte Zelle noch nichts gebunden hat. -->
    <string name="cd_app_icon">App-Symbol</string>
</resources>

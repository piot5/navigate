<?xml version="1.0" encoding="utf-8"?>
<!-- Eigene Attribute. Es gibt genau eines, und der Grund dafür steht in
     ui/PanelScrollView.kt: `android:maxHeight` gibt es am ScrollView nicht —
     die Plattform kennt es nur für ImageView, ExpandableListView und das interne
     MaxHeightFrameLayout. Ein Attribut im eigenen Namensraum (`app:maxHeight`)
     lässt sich nicht still ignorieren: es ist hier deklariert und wird gelesen. -->
<resources>
    <declare-styleable name="PanelScrollView">
        <!-- Höchstens so hoch; danach scrollt die Ansicht in sich, statt den
             Block (und mit ihm das Raster darunter) wachsen zu lassen. -->
        <attr name="maxHeight" format="dimension" />
    </declare-styleable>
</resources>

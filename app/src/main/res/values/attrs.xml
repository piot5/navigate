<?xml version="1.0" encoding="utf-8"?>
<!-- Custom attributes. There is exactly one, and the reason for it is in
     ui/PanelScrollView.kt: `android:maxHeight` does not exist on ScrollView —
     the platform only knows it for ImageView, ExpandableListView and the internal
     MaxHeightFrameLayout. An attribute in our own namespace (`app:maxHeight`)
     cannot be silently ignored: it is declared here and read. -->
<resources>
    <declare-styleable name="PanelScrollView">
        <!-- At most this tall; beyond that the view scrolls within itself instead
             of letting the block (and with it the grid below) grow. -->
        <attr name="maxHeight" format="dimension" />
    </declare-styleable>
</resources>

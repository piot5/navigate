<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Deliberately the most ordinary theme there is: opaque, no translucency,
         no custom window animations, no window-size tricks.

         Why so strict: up to 0.6 the theme was translucent (to avoid a black
         flash when pressing HOME) and set all
         window animations to @null. On the target device the window was then
         drawn, focused and **usable** — but not visible; only on
         a click did it flash up briefly. A translucent window keeps the app
         below alive (merely paused); every app visible on this TV has an
         opaque window, where the app below is stopped. The
         rebuild takes exactly that: an opaque theme, nothing else.

         `windowBackground` is the same shade as the home screen — the
         starting window is then a dark rectangle instead of a white or
         black flash, and `windowDisablePreview` (a special measure) is
         not needed. -->
    <style name="Theme.Navigate" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_home</item>
        <item name="android:colorBackground">@color/bg_home</item>
    </style>

</resources>

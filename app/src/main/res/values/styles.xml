<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Bewusst das gewöhnlichste Theme, das es gibt: opak, ohne Translucenz,
         ohne eigene Fenster-Animationen, ohne Fenstergrößen-Tricks.

         Warum so streng: Bis 0.6 war das Theme translucide (damit beim
         HOME-Druck kein schwarzer Blitz kommt) und setzte alle
         Fenster-Animationen auf @null. Auf dem Zielgerät war das Fenster danach
         gezeichnet, fokussiert und **bedienbar** — aber nicht sichtbar; nur bei
         einem Klick blitzte es kurz auf. Ein translucentes Fenster lässt die App
         darunter am Leben (nur pausiert); jede auf diesem Fernseher sichtbare
         App hat ein opakes Fenster, bei dem die App darunter gestoppt wird. Der
         Neubau nimmt genau das: ein opakes Theme, sonst nichts.

         `windowBackground` ist derselbe Farbton wie die Home-Seite — das
         Starting-Window ist damit ein dunkles Rechteck statt eines weißen oder
         schwarzen Blitzes, und `windowDisablePreview` (eine Sonderbehandlung)
         wird nicht gebraucht. -->
    <style name="Theme.Navigate" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_home</item>
        <item name="android:colorBackground">@color/bg_home</item>
    </style>

</resources>

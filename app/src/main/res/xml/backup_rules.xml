<?xml version="1.0" encoding="utf-8"?>
<!-- The counterpart to res/xml/data_extraction_rules.xml for Android 11 and
     older (minSdk 23). `allowBackup=false` switches backups off there anyway;
     this file states the same explicitly and thereby satisfies the lint check
     DataExtractionRules, which otherwise notes that dataExtractionRules only
     applies from Android 12 on. -->
<full-backup-content>
    <exclude domain="root" path="." />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<!-- See AndroidManifest.xml (application/@android:dataExtractionRules) and
     app/build.gradle.kts. In short: `allowBackup=false` remains the statement;
     this file is the form Android 12 requires for it. Everything is excluded
     — a launcher's configuration consists of package names and paths that
     may be missing or wrong on another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>

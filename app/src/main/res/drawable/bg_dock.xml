<?xml version="1.0" encoding="utf-8"?>
<!-- Die Dock-Zeile schwebt über dem Inhalt: eigene Ränder rundum, damit auf
     TVs mit Overscan nichts abgeschnitten wird und der Rand zur laufenden App
     sichtbar bleibt. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dock_bg" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/dock_stroke" />
</shape>

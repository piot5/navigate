<?xml version="1.0" encoding="utf-8"?>
<!-- Focus marker for grid cells.
     GridView sets the selected cell to state_selected (not focused),
     so state_selected is the trigger. AppGridView additionally mirrors the
     GridView focus into this state (see AppGridView.onFocusChanged),
     so the marker disappears when the window loses focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/item_focus_fill" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/item_focus_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Focus marker of the “Now Playing” block.
     Unlike in the grid (where the trigger is state_selected, see
     bg_grid_item) it is state_focused here: the block is a clickable child
     in an ordinary layout, not an entry of a GridView. Without focus it stays
     without a border — the row should look like text, not like a button. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/item_focus_fill" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/item_focus_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>

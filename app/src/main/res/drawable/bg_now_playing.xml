<?xml version="1.0" encoding="utf-8"?>
<!-- Fokus-Markierung des „Now Playing“-Blocks.
     Anders als im Raster (dort ist der Auslöser state_selected, siehe
     bg_grid_item) ist es hier state_focused: der Block ist ein anklickbares Kind
     in einem gewöhnlichen Layout, kein Eintrag einer GridView. Ohne Fokus bleibt
     er ohne Rahmen — die Zeile soll wie Text aussehen, nicht wie ein Knopf. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/item_focus_fill" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/item_focus_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Marker of the selected row in a ListView (`listSelector`).
     Deliberately without a state selector: the ListView draws the listSelector
     only while it has the focus itself — exactly the wanted behavior. The same
     shape as @drawable/bg_grid_item, so grid and settings look
     alike. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/item_focus_fill" />
    <corners android:radius="12dp" />
    <stroke
        android:width="2dp"
        android:color="@color/item_focus_stroke" />
</shape>

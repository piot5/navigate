<?xml version="1.0" encoding="utf-8"?>
<!-- The “…” button below the app row.

     The trigger is `state_focused` (not `state_selected` as in the grid): the
     button is a real, focusable view, not a GridView cell. Visually it is
     the same border as on a selected app cell — rounded, blue —,
     so the interface speaks a single language. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/item_focus_fill" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/item_focus_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/item_idle_stroke" />
        </shape>
    </item>
</selector>

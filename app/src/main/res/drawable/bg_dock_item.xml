<?xml version="1.0" encoding="utf-8"?>
<!-- Fokus-Markierung für Dock-Elemente (echte fokussierbare Views, deshalb
     state_focused statt state_selected). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/item_focus_fill" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/item_focus_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>

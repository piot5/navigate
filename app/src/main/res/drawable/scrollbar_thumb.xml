<?xml version="1.0" encoding="utf-8"?>
<!-- Der Griff der Scrollbar im Now-Playing-Block (seit 0.15.1).

     Die Scrollbar ist hier **kein Beiwerk**: der Block oben links ist die einzige
     Fläche der Home-Seite, die mehr Zeilen hat, als sie zeigt. Ohne den Griff
     sieht man nicht, dass der Verlauf weitergeht und wo man darin steht.

     Deshalb ist er dauerhaft zu sehen (`fadeScrollbars="false"` in
     activity_home.xml) — und deshalb ist er zurückhaltend: er zeigt eine
     Position an, er ist kein Bedienelement. 40 % Weiß reicht auf dem dunklen
     Hintergrund, ohne mit der Fokus-Markierung (item_focus_stroke) zu
     konkurrieren. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/scrollbar_thumb" />
    <corners android:radius="@dimen/now_playing_scrollbar_radius" />
</shape>

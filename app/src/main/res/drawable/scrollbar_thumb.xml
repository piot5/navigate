<?xml version="1.0" encoding="utf-8"?>
<!-- The scrollbar thumb in the Now Playing block (since 0.15.1).

     The scrollbar here is **not a garnish**: the block at the top left is the
     only area of the home screen that has more rows than it shows. Without the
     thumb you cannot see that the history continues and where you are in it.

     That is why it is always visible (`fadeScrollbars="false"` in
     activity_home.xml) — and why it is restrained: it shows a
     position, it is not a control. 40% white is enough on the dark
     background, without competing with the focus marker (item_focus_stroke). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/scrollbar_thumb" />
    <corners android:radius="@dimen/now_playing_scrollbar_radius" />
</shape>

# --- Build outputs ----------------------------------------------------------
# Everything Gradle/AGP produces. Never versioned: it is reproducible
# (see README "Building") and several hundred MB in size on a weak device
build/
.gradle/
.kotlin/
captures/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
*.hprof

# --- Local configuration ----------------------------------------------------
# Contains the SDK path of the respective machine (sdk.dir) — different per computer.
local.properties

# --- Signing material: never into the repo (like KeyTab) --------------------
# The release keystore and its passwords live only locally or as a
# CI secret. app/build.gradle.kts reads them from the environment or from
# keystore/keystore.properties and does not abort without them — it stays
# with the unsigned APK.
keystore/
*.jks
*.keystore

# --- IDE and editor ---------------------------------------------------------
*.iml
.idea/
.vscode/
*.swp
*~

# --- Logs and throwaway files -----------------------------------------------
build_*.log
*.log
__pycache__/
*.pyc
*.bak
*.orig
*.rej

# --- Operating system -------------------------------------------------------
.DS_Store
Thumbs.db

# Note: gradle/wrapper/gradle-wrapper.jar is deliberately kept versioned —
# without it ./gradlew does not run. Hence no "*.jar" here.
